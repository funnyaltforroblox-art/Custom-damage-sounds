-- Sound Pool Cache
local soundPools = {
    low = {},
    medium = {},
    high = {}
}

-- Helper to retrieve valid sound paths and update the cache
local function updateSoundPool(tier)
    local folderPath = config.baseFolder .. "/" .. tier
    local files = listfiles(folderPath)
    local pool = {}
    for _, path in ipairs(files) do
        local ext4 = path:sub(-4):lower()
        local ext5 = path:sub(-5):lower()
        if ext4 == ".mp3" or ext4 == ".wav" or ext4 == ".ogg" or ext5 == ".ogg" then
            table.insert(pool, path)
        end
    end
    soundPools[tier] = pool
    return pool
end

-- Initial population of sound pools
updateSoundPool("low")
updateSoundPool("medium")
updateSoundPool("high")

-- Audio Player
local function playRandomDamageSound(tier)
    local pool = soundPools[tier] or {}
    if #pool == 0 then return end
    
    local randomTrackPath = pool[math.random(1, #pool)]
    
    local success, assetId = pcall(function() return getcustomasset(randomTrackPath) end)
    
    if success and assetId then
        local sound = Instance.new("Sound")
        sound.SoundId = assetId
        sound.Volume = config.volume
        sound.Parent = game:GetService("SoundService")
        sound:Play()
        sound.Ended:Connect(function() sound:Destroy() end)
    end
end

-- Monitor Character Health & Censor Bar Status
local player = game:GetService("Players").LocalPlayer
local camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")

local censorEnabled = false
local censorFrame = nil
local renderConnection = nil

local function cleanupCensorBar()
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end
    if censorFrame then
        censorFrame:Destroy()
        censorFrame = nil
    end
end

local function applyCensorBar(character)
    cleanupCensorBar()
    
    if not censorEnabled or not character then return end

    local head = character:WaitForChild("Head", 5)
    if not head then return end

    -- Create ScreenGui holder
    local success, coreGui = pcall(function() return game:GetService("CoreGui") end)
    local censorGui = Instance.new("ScreenGui")
    censorGui.Name = "CensorBarGui"
    censorGui.ResetOnSpawn = false
    censorGui.Parent = success and coreGui or player:WaitForChild("PlayerGui")

    -- 2D Screen-space Frame
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.new(0, 0, 0)
    frame.BorderSizePixel = 0
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Visible = false
    frame.Parent = censorGui

    censorFrame = censorGui

    -- Update 2D position and scale every frame based on camera perspective
    renderConnection = RunService.RenderStepped:Connect(function()
        if not head or not head.Parent then
            cleanupCensorBar()
            return
        end

        local headPos = head.Position
        local screenPos, onScreen = camera:WorldToViewportPoint(headPos)

        if onScreen then
            -- Distance scaling calculation so the bar expands/shrinks naturally
            local depth = math.max(screenPos.Z, 0.1)
            local baseWidth = 100 -- Width multiplier
            local baseHeight = 50 -- Height multiplier
            
            local scaledWidth = baseWidth / (depth * 0.1)
            local scaledHeight = baseHeight / (depth * 0.1)

            frame.Size = UDim2.new(0, scaledWidth, 0, scaledHeight)
            frame.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
            frame.Visible = true
        else
            frame.Visible = false
        end
    end)
end

local function listenToHealth(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end
    local lastHealth = humanoid.Health
    humanoid.HealthChanged:Connect(function(currentHealth)
        if currentHealth < lastHealth and lastHealth > 0 then
            local damage = lastHealth - currentHealth
            if damage > 0 and damage <= config.lowThresh then
                playRandomDamageSound("low")
            elseif damage > config.lowThresh and damage <= config.medThresh then
                playRandomDamageSound("medium")
            elseif damage > config.medThresh then
                playRandomDamageSound("high")
            end
        end
        lastHealth = currentHealth
    end)
end

local function onCharacterAdded(character)
    listenToHealth(character)
    applyCensorBar(character)
end

if player.Character then onCharacterAdded(player.Character) end
player.CharacterAdded:Connect(onCharacterAdded)

